{
  "name": "nightjar",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-trixie",
  "features": {
    // moby has no trixie packages; docker-ce does
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": false
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    // the lock file pins the features; these pin what the features install, which they
    // otherwise resolve to latest at build time - every candidate gets one toolchain
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
      "version": "1.34.11",
      "helm": "3.19.0",
      "minikube": "none"
    },
    "ghcr.io/devcontainers/features/terraform:1": {
      "version": "1.16.1",
      "tflint": "none",
      "terragrunt": "none"
    }
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },
  "remoteEnv": {
    "PATH": "/usr/local/bin:/home/vscode/.local/bin:${containerEnv:PATH}",
    "UV_LINK_MODE": "copy"
  },
  "onCreateCommand": "scripts/bootstrap.sh prebuild",
  "updateContentCommand": "scripts/bootstrap.sh deps",
  "postCreateCommand": "scripts/bootstrap.sh run",
  "postStartCommand": "scripts/bootstrap.sh infra",
  // the editor CLI only exists once VS Code has attached, and a missing one must not fail the attach
  "postAttachCommand": "bash -lc 'if command -v code >/dev/null; then code CHALLENGE.md; fi'",
  "waitFor": "postCreateCommand",
  "forwardPorts": [9400, 9401, 8233, 7233, 27017, 4317, 9000, 9001],
  "portsAttributes": {
    "9400": { "label": "nightjar-ingest API", "onAutoForward": "notify" },
    "9401": { "label": "mock upstream" },
    "8233": { "label": "Temporal UI" },
    "7233": { "label": "Temporal gRPC" },
    "27017": { "label": "MongoDB" },
    "4317": { "label": "OTLP gRPC" },
    "9000": { "label": "MinIO S3 API" },
    "9001": { "label": "MinIO console" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "charliermarsh.ruff",
        "ms-python.python",
        "hashicorp.terraform",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "task.allowAutomaticTasks": "on"
      }
    }
  }
}
