{
  "name": "nightjar",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },
  "remoteEnv": {
    "PATH": "/usr/local/bin:/home/vscode/.local/bin:${containerEnv:PATH}",
    "UV_LINK_MODE": "copy"
  },
  "onCreateCommand": "scripts/bootstrap.sh images",
  "updateContentCommand": "scripts/bootstrap.sh deps",
  "postCreateCommand": "scripts/bootstrap.sh run",
  "postStartCommand": "scripts/bootstrap.sh infra",
  "waitFor": "postCreateCommand",
  "forwardPorts": [9400, 9401, 8233, 7233, 27017, 4317],
  "portsAttributes": {
    "9400": { "label": "nightjar-ingest API", "onAutoForward": "notify" },
    "9401": { "label": "mock upstream" },
    "8233": { "label": "Temporal UI" },
    "7233": { "label": "Temporal gRPC" },
    "27017": { "label": "MongoDB" },
    "4317": { "label": "OTLP gRPC" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["charliermarsh.ruff", "ms-python.python"],
      "settings": {
        "task.allowAutomaticTasks": "on"
      }
    }
  }
}
