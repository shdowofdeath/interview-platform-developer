{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start nightjar",
      "dependsOn": ["API (:9400)", "Temporal worker", "Mock upstream (:9401)"],
      "dependsOrder": "parallel",
      "runOptions": { "runOn": "folderOpen" },
      "problemMatcher": []
    },
    {
      "label": "API (:9400)",
      "type": "shell",
      "command": "uv run uvicorn app:app --host 0.0.0.0 --port 9400 --reload",
      "options": { "cwd": "${workspaceFolder}/services/ingest" },
      "isBackground": true,
      "presentation": { "group": "nightjar", "panel": "dedicated", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "Temporal worker",
      "type": "shell",
      "command": "uv run python worker.py",
      "options": { "cwd": "${workspaceFolder}/services/ingest" },
      "isBackground": true,
      "presentation": { "group": "nightjar", "panel": "dedicated", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "Mock upstream (:9401)",
      "type": "shell",
      "command": "uv run uvicorn app:app --host 0.0.0.0 --port 9401",
      "options": { "cwd": "${workspaceFolder}/services/mock-upstream" },
      "isBackground": true,
      "presentation": { "group": "nightjar", "panel": "dedicated", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "Verify environment",
      "type": "shell",
      "command": "scripts/verify_env.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "panel": "dedicated", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "Re-seed the database",
      "type": "shell",
      "command": "uv run python scripts/seed.py",
      "options": { "cwd": "${workspaceFolder}/services/ingest" },
      "presentation": { "panel": "dedicated", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "Infrastructure status",
      "type": "shell",
      "command": "docker compose ps",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "panel": "dedicated", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "Collector logs",
      "type": "shell",
      "command": "docker compose logs -f otel-collector",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "presentation": { "panel": "dedicated", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "Tests",
      "type": "shell",
      "command": "uv run pytest -q",
      "options": { "cwd": "${workspaceFolder}/services/ingest" },
      "presentation": { "panel": "dedicated", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "Ruff",
      "type": "shell",
      "command": "uv run ruff check .",
      "options": { "cwd": "${workspaceFolder}/services/ingest" },
      "presentation": { "panel": "dedicated", "reveal": "always" },
      "problemMatcher": []
    }
  ]
}
